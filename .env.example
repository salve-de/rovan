NEXT_PUBLIC_SITE_URL=http://localhost:3000

OPENAI_API_KEY=
OPENAI_DISCOVERY_MODEL=gpt-5.6-luna
OPENAI_SEARCH_MODEL=gpt-5.6-luna
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

RESEND_API_KEY=
WATCH_FROM_EMAIL=

CRON_SECRET=
ADMIN_SECRET=
RATE_LIMIT_SALT=
# AUTH_SECRET: セッション署名用の秘密鍵。32文字以上のランダム値を設定する。
# 生成方法: openssl rand -base64 32
# 本番でAUTH_SECRET未設定の場合、ログイン機能は安全側に倒れて利用不可になる。
AUTH_SECRET=
# Google OAuthログイン用。未設定時はGoogleログインボタンを表示しない。
# 生成方法: https://console.cloud.google.com/apis/credentials で認証情報を作成する。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FREE_SCANS_PER_HOUR=4
WATCH_PROMPT_BATCH_SIZE=8
WATCH_OBSERVATION_CONCURRENCY=9
WATCH_RESUME_MINUTES=15

# Rovan: 実際に管理する公開URL・認証済み送信元を設定する。ドメインは自動購入しない。
# WATCH_FROM_EMAIL は Rovan <認証済みメールアドレス> の形式。
# 掲載照会・非公開申請窓口。未設定時は /support を案内する。
SELLER_EMAIL=
SELLER_LEGAL_NAME=
SELLER_REPRESENTATIVE=
SELLER_ADDRESS=
SELLER_PHONE=
SELLER_SUPPORT_HOURS=
